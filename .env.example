# Optional openAIP overlay
NEXT_PUBLIC_OPENAIP_API_KEY=

# Optional ANC Portugal VFR chart raster overlay.
# Convert the GeoTIFF/KMZ to web XYZ tiles and point this to the public tile URL.
# Examples:
# NEXT_PUBLIC_VFR_CHART_TILES_URL=/vfr-chart/{z}/{x}/{y}.png
# NEXT_PUBLIC_VFR_CHART_TILES_URL=https://example.com/vfr-chart/{z}/{x}/{y}.png
NEXT_PUBLIC_VFR_CHART_TILES_URL=
NEXT_PUBLIC_VFR_CHART_MIN_ZOOM=6
NEXT_PUBLIC_VFR_CHART_MAX_NATIVE_ZOOM=13
NEXT_PUBLIC_VFR_CHART_OPACITY=0.78
NEXT_PUBLIC_VFR_CHART_ATTRIBUTION="ANC Portugal 1:500 000 / NAV Portugal"
