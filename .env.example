NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SECRET_KEY=
# Private 32+ character random value; never expose in a NEXT_PUBLIC_ variable.
# Keep this value unchanged or existing four-digit PINs will cease to work.
NAVLOG_PIN_PEPPER=

# Preview-only NavLog confirmation and PIN recovery emails via Brevo's REST API.
# Set a Brevo API key (not the SMTP key) in Vercel as a Secret, Preview target.
# The verified sender is Briefings <noreply.briefings@gmail.com>.
BREVO_API_KEY=
# Optional canonical HTTPS URL for token links, otherwise VERCEL_URL is used.
NAVLOG_PUBLIC_URL=

# Optional admin email notifications for Feedback and unblock requests.
# Resend can use onboarding@resend.dev while testing; use a verified sender for production.
RESEND_API_KEY=
ADMIN_NOTIFICATION_EMAIL=
ADMIN_NOTIFICATION_FROM="Briefings <onboarding@resend.dev>"

# Live NOTAM overlay for Area Map.
# Default provider: NOTAC (server-side only; never expose this token to the browser).
NOTAM_PROVIDER=notac
NOTAC_API_TOKEN=
# Optional provider base URL override.
NOTAM_API_BASE_URL=https://notac.aero/api/v1

# Optional openAIP overlay
NEXT_PUBLIC_OPENAIP_API_KEY=

# ANC Portugal VFR chart tiles are bundled in the repository and prepared
# automatically before `next dev` and `next build`.

# Fallback when converted from the KMZ SuperOverlay into a manifest + PNG image overlays:
# NEXT_PUBLIC_VFR_CHART_MANIFEST_URL=/vfr-chart/manifest.json
# NEXT_PUBLIC_VFR_CHART_MANIFEST_URL=https://example.com/vfr-chart/manifest.json
NEXT_PUBLIC_VFR_CHART_MANIFEST_URL=

# Optional: force one KMZ manifest level for a uniform chart when the higher level has missing/corrupted images.
# Example: NEXT_PUBLIC_VFR_CHART_MANIFEST_LEVEL=5
NEXT_PUBLIC_VFR_CHART_MANIFEST_LEVEL=

NEXT_PUBLIC_VFR_CHART_MIN_ZOOM=6
NEXT_PUBLIC_VFR_CHART_MAX_NATIVE_ZOOM=12
NEXT_PUBLIC_VFR_CHART_OPACITY=0.78
NEXT_PUBLIC_VFR_CHART_ATTRIBUTION="ANC Portugal 1:500 000 / NAV Portugal"
