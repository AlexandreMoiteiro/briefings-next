{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/lib/navlog": [
        "./src/lib/navlog-rounded.ts"
      ],
      "@/lib/navlog-engine": [
        "./src/lib/navlog-engine-display.ts"
      ],
      "@/lib/pdf/navlog-form-pdf": [
        "./src/lib/pdf/navlog-form-pdf-v3.ts"
      ],
      "@/lib/performance/p2006t-performance": [
        "./src/lib/performance/p2006t-performance-conditioned.ts"
      ],
      "@/lib/pdf/p2006t-performance-pdf-v3": [
        "./src/lib/pdf/p2006t-performance-pdf-v13.ts"
      ],
      "@/lib/pdf/p2006t-performance-pdf": [
        "./src/lib/pdf/p2006t-performance-pdf-complete.ts"
      ],
      "@/lib/pdf/p2008-performance-pdf-v2": [
        "./src/lib/pdf/p2008-performance-pdf-stable.ts"
      ],
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules"]
}
